# Application settings
APP_ENV=development
APP_NAME=hermes-rag-mcp-platform
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# API Security
API_KEY=demo-key

# Database
POSTGRES_URL=postgresql://hermes:hermes@localhost:5432/hermes
POSTGRES_PASSWORD=hermes123

# Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hermes_docs
RAG_VECTOR_STORE=faiss
RAG_COLLECTION_NAME=hermes_docs

# Cache
REDIS_URL=redis://localhost:6379/0

# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.1:8b
HERMES_API_URL=http://localhost:8000

# Cloud LLM
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# File uploads
UPLOADS_DIR=./data/uploads
SQLITE_PATH=./data/app.db

# MCP Servers
MCP_SERVERS={"filesystem": {"enabled": true}, "github": {"enabled": true}, "web_search": {"enabled": true}}
